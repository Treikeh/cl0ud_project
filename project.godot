; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://common/fmod_banks/Desktop/"
General/should_load_by_name=true

[application]

config/name="C.L.0.U.D."
config/version="0.0.1"
config/tags=PackedStringArray("school")
run/main_scene="uid://c5ekxb0gxgxo3"
config/use_custom_user_dir=true
config/custom_user_dir_name="cl0ud"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

FmodManager="*uid://cds10pm7hwn3p"
Globals="*uid://0mwlrko7w0hn"
LevelManager="*uid://lxntnfj50l0x"
SaveManager="*uid://y88yxm44ru0s"
SettingsManager="*uid://br7wp743q5fja"

[display]

window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/cl0ud_plugin/plugin.cfg", "res://addons/fmod/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "pink",
"res://common/": "gray",
"res://debug/": "red",
"res://entities/": "blue",
"res://environment/": "purple",
"res://gui/": "green",
"res://levels/": "orange"
}

[global_group]

persistent=""
player=""
day_night_cycle=""


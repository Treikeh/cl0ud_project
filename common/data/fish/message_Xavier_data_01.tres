script = ExtResource("1_tkkh0")
sender = "Xavier "
recipient = "Martin "
messages = Array[Dictionary]([{
"LINES": [" Xavier my man, you said you wanted a TV? ", " Well, You`re in luck, I plan on selling mine on Praig`s list soon, but you can take it off my hands early if you give me that good ka-ching. "],
"WHO": "Martin "
}, {
"LINES": [" Hell yeah I want to buy a TV, which model is it? "],
"WHO": "Xavier "
}, {
"LINES": [" It`s a Preuss 55\" TOS2000/4 4K LED smart TV. ", " It`s market price is around 8000 cloudbucks but ill give it over for 3000 since its been used. "],
"WHO": "Martin "
}, {
"LINES": [" It ain`t broken, is it? That`s a very large discount. "],
"WHO": "Xavier "
}, {
"LINES": [" Nah, It`s just alittle dusty, That`s all. ", " I just haven`t spent as much time watching TV in the recent months, and I need this money for something else ASAP. "],
"WHO": "Martin "
}, {
"LINES": [" I totally get it. However, I will be taking that TV off your hands, that`s an absolute steal. "],
"WHO": "Xavier "
}, {
"LINES": [" Nice! Send me the cash to my account number: 4102 54 3707 and come meet me at my place. "],
"WHO": "Martin "
}, {
"LINES": [" Will do. I`ll also send some of the cash I owe you for the previous weekend hangout. "],
"WHO": "Xavier "
}, {
"LINES": [" Thanks! Remember: Tomorrow at 13:00 at my place. "],
"WHO": "Martin "
}, {
"LINES": [" Your address was Parkstreet Blvd.  ", " 21th house? Concrete building? With that ugly yellow mailbox? "],
"WHO": "Xavier "
}, {
"LINES": [" You got it. See ya there. "],
"WHO": "Martin "
}, {
"LINES": [" Xavier Transfered 3055 Cloudbucks to account number 410253 3707 via the Card 8203 1505 6733 2359."],
"WHO": "SYSTEM"
}])

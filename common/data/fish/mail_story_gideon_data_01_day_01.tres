[resource]
script = ExtResource("1_srcai")
from = "Gideon "
to = "Smog-Riders "
subject = "Upcoming operations "
content = " Hello y’all. Gideon here. 
 
 As mentioned in previous announcements, we’re conducting a raid against the Los Sangrientos warehouses tomorrow. 
 
 We are breaking and entering to take some of their improvised bombs and some of their firearms. Hopefully, several crates of them. 
 
 Meetup is tomorrow at our central warehouse at 09:00 exactly. 
 
 I want only those capable of fighting and who own armored bikes. 
 
 The operation will be straightforward, but contact me if you have any further questions. 
 
 -Gideon"

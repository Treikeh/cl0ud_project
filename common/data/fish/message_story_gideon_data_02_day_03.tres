[resource]
script = ExtResource("1_vkjv7")
sender = "Gideon "
recipient = "Jordan "
messages = Array[Dictionary]([{
"LINES": [" Jordan? ", " Do you copy? ", " I lost connection due to an signal jammer they deployed. ", " Fuck we lost so many. ", " It's just me and Molly left in squadron 1. ", " I don't typically want to do this but shit is hitting the fan, and I've lost contact with Squadron 3 and 5. ", " Emergency regrouping at in my personal home. ", " It's the 77th Fairdon street. ", " I think we've might have our communications leaked previously, which means we gotta go to somewhere unexpected. ", " Please try to get contact with Squadron 6 in person to relay this information. ", " Please respond. ", " Gideon out."],
"WHO": "Gideon "
}])

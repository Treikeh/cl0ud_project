[gd_resource type="Resource" script_class="MessageData" format=3 uid="uid://bs2k3wwd1rcjx"]

[ext_resource type="Script" uid="uid://knk2w0s0q2la" path="res://entities/fish/message/message_data.gd" id="1_panic"]

[resource]
script = ExtResource("1_panic")
sender = "Anonymous Resident of Cloud City "
recipient = "Gideon "
messages = Array[Dictionary]([{
"LINES": [" Hello Gideon. I heard of the Smog-Riders' recent activities. ", " I just wanted to say that we are beyond thankful for the service that you guys provide. ", " Is there any way we can repay you? "],
"WHO": "Anonymous Resident of Cloud City "
}, {
"LINES": [" Don't worry, no direct payment needed as we work off donations. "],
"WHO": "Gideon "
}, {
"LINES": [" I insist! ", " Can we at least feed you and your comrades? ", " We are planning on having a neighborhood-wide dumpling dinner. ", " Atleast come and taste them! "],
"WHO": "Anonymous Resident of Cloud City "
}, {
"LINES": [" Now, there is an offer I can take up, they are my favorites meal afterall."],
"WHO": "Gideon "
}])

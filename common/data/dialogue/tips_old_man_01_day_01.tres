[ext_resource type="Script" uid="uid://b0pj0dtodw2q8" path="res://common/data/dialogue/dialogue_data.gd" id="1_tyeht"]

[resource]
script = ExtResource("1_tyeht")
name = "Old Man"
lines = Array[String](["Data-fishin' is time-consumin' work.", "Yer' gonna realise the day is over faster than you expected.", "However, takin' your time to talk to yer fellow data-fishermen, like me and others, usually mentally slows down the perception of time passin'.", "Same goes for readin' the contents of a data-fish, or lookin' at Chops's wares or anything that's not directly data-fishin' or starin' out at the Cloud.", "So feel free to take your time interacting with Concrete Cove and her residents.", "You might even learn somethin' you didn't realise you needed to know.", "...", "Anyhoo! That's all I have to say about that."])

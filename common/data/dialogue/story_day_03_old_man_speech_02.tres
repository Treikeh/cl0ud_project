script = ExtResource("1_cf367")
name = "Old Man"
lines = Array[String](["…", "Now, I know yer’ curious about why I invited you down here.", "The truth is probably not somethin’ yer’ gonna like to hear, but it’s just how it is.", "The data you have sold recently has caused some trouble for the victims, especially for Ellie, Xavier, and Gideon."])

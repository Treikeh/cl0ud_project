script = ExtResource("1_8m6wp")
name = "The Gardener"
lines = Array[String](["Yes, Actually!", "Concrete Cove is an excellent place to grow plantlife.", "It is way above the Cloud so that the plants get both sunlight and clean air.", "Concrete Cove is also fairly protected from bad actors due to the Graham Brothers."])

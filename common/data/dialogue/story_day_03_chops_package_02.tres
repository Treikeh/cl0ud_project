[ext_resource type="Script" uid="uid://b0pj0dtodw2q8" path="res://common/data/dialogue/dialogue_data.gd" id="1_wip2q"]

[resource]
script = ExtResource("1_wip2q")
name = "\"Chops\""
lines = Array[String](["Now, I ain't under any postman's oath, but as I said, the Old Man used all of his favours to both make me deliver this thing...", "And to not peak inside it.", "Trust me, I really wanted to, but the Old Man seemed serious about it.", "Besides, I have an, somewhat good, reputation to uphold.", "So I'll respect his wish.", "Anyways, do you wish to buy or sell anything?"])
choices = Array[String](["Buying", "Selling", "Profiles builder?", "Nevermind"])

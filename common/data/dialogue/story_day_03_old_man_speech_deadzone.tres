[ext_resource type="Script" uid="uid://b0pj0dtodw2q8" path="res://common/data/dialogue/dialogue_data.gd" id="1_i8jhr"]

[resource]
script = ExtResource("1_i8jhr")
name = "Old Man"
lines = Array[String](["Hm, I s’pose it is.", "Without Cloud Masks, no livin’ being can safely breathe down here.", "Did you know that the Cloud was first released from Cloud City?", "Cloud City was given its name because of that, after all.", "And now the ground level of every city in the world is inhospitable because of said Cloud.", "We’re technically worse for it, societally, but I will admit that there is a beautiful serenity residin’ inside the Cloud."])

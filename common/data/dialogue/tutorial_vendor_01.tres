[ext_resource type="Script" uid="uid://b0pj0dtodw2q8" path="res://common/data/dialogue/dialogue_data.gd" id="1_ixwpe"]

[resource]
script = ExtResource("1_ixwpe")
name = "\"Chops\""
lines = Array[String](["Well, well, well! A new face!", "You can call me Chops.", "I am the local dealer here supplying fine data-fishers, like you, with all of the gear they need.", "I also buy data-fishes and profiles off you, once you have any.", "Speaking of which, I see that you have no fishing rod on your person.", "That is one of many problems I can solve, for the right price.", "…", "As you are new… I’d wager you don’t have much disposable income on ya, so I’ll sell you one of my cheaper offerings.", "She might be quite beat-up, but she’ll do the job.", "Have a look."])
choices = Array[String](["Open Shop", "Nevermind"])

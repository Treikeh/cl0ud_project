name = "Old Man"
lines = Array[String](["Ahoy there!", "I see that you made it in one piece.", "However, I notice that you’re lacking one piece of crucial fishing equipment.", "Your rod!", "I’d check by with “Chops” to see if he has any old rods on hand."])

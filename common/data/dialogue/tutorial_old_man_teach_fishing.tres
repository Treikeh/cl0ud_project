[ext_resource type="Script" uid="uid://b0pj0dtodw2q8" path="res://common/data/dialogue/dialogue_data.gd" id="1_qf8nx"]

[resource]
script = ExtResource("1_qf8nx")
name = "Old Man"
lines = Array[String](["Now that you have your hand on a fishin' rod, it’s time to get down to brass tacks on how to data-fish.", "To start, you throw that sucker as far into the cloud as you can.", "The further you throw, the better the data-fish you can fish up.", "From there, you wait for a data-fish to get caught on yer hook.", "Then, it’s you against the fish, with a precision-timed reel to start the tug of war…", "You have to move yer fishin' rod against the movements of the data-fish.", "Precision and tracking are key to tire out the data-fish, so pay attention to which direction you have to move the rod!", "And if you have done everything correctly, then you’ll reel in a datafish!", "Or a piece of junk…", "Regardless, you then sell your data-fish to Chops for a profit or use them to build a profile.", "I assume you don’t have your hands on a profile builder yet, so I’d just focus on selling the fish to chops for now.", "Happy data-fishin' and a warm welcome to Concrete Cove."])

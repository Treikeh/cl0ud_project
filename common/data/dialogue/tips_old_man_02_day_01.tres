[resource]
script = ExtResource("1_jhu3j")
name = "Old Man"
lines = Array[String](["Here is one important one: Don't lose yer humanity!", "Alright, I'm pullin' yer leg.", "But seriously... think about what data yer' sellin'", "Minimizin' the collateral damage you cause with data sold is important for a handful of reasons.", "I ain't gonna list all of them, but here are two important ones:", "First, excessive amounts of sensitive data-fishi bein' sold cause people to invest in alternatives to the Cloud-based communication.", "Second, ruinin' lives is not good for the soul.", "I know yer' not truly evil, kid...", "So don't make the wrong decisions.", "...", "I Hope that helps..."])
